# Inicio seguro, sin clave privada. pnpm auth:setup crea el hash de acceso.
BOT_MODE=paper
CAPITAL_USD=50
BOT_DATABASE=.runtime/paper.sqlite
BOT_CONFIG=
DASHBOARD_PORT=3001
DASHBOARD_ORIGIN=http://127.0.0.1:3001
DASHBOARD_PASSWORD_HASH=
POLL_INTERVAL_MS=2000
# Solo paper: consumo supuesto; el precio de gas y POL/USD se consulta en tiempo real.
PAPER_GAS_UNITS=300000
PAPER_GAS_MULTIPLIER=1.5
# IDs numéricos Gamma separados por comas. Vacío: descubrimiento público.
MARKET_IDS=

# Solo se inicializan al activar live y pasar la revisión de evidencia.
POLYMARKET_PRIVATE_KEY=
POLYGON_RPC_URL=
LIVE_ACK=
LIVE_EVIDENCE_FILE=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Permanecen experimentales y desactivadas.
DIPARB_ENABLED=false
SMARTMONEY_ENABLED=false
TREND_ANALYSIS_ENABLED=false
